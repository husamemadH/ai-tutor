# --- OpenRouter (chat + embeddings) ---
OPENROUTER_API_KEY=

# --- Groq (speech-to-text; optional — typing still works without it) ---
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_MAX_SECONDS=30

# --- Azure Speech (text-to-speech; optional — replies still stream as text) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=ar-SA-HamedNeural
AZURE_TTS_RATE=0%
AZURE_TTS_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_TTS_MAX_CHARS=2000

# --- Tutor output language: jordanian | msa ---
TUTOR_DIALECT=msa

# --- Models ---
CHAT_MODEL=deepseek/deepseek-v4.1-flash
OCR_MODEL=google/gemini-2.5-flash
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://ai_tutor:ai_tutor@localhost:5434/ai_tutor

# --- Tutor behaviour ---
RETRIEVAL_TOP_K=6
MEMORY_WINDOW_TURNS=8
REQUEST_TIMEOUT=120

TUTOR_SERVICE_TOKEN=
TUTOR_MAX_CONCURRENT=4
TUTOR_GENERATION_TIMEOUT=120
POSTGRES_PASSWORD=ai_tutor
