# --- OpenRouter (single key for chat + embeddings) ---
OPENROUTER_API_KEY=

# --- Models ---
CHAT_MODEL=deepseek/deepseek-v4.1-flash
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIM=1024

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://ai_tutor:ai_tutor@localhost:5434/ai_tutor

# --- Tutor behaviour ---
RETRIEVAL_TOP_K=6
MEMORY_WINDOW_TURNS=8
REQUEST_TIMEOUT=120