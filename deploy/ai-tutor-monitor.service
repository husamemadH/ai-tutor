[Unit]
Description=External AI Tutor health check and email notification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ai-tutor-monitor
Group=ai-tutor-monitor
EnvironmentFile=/etc/ai-tutor-monitor/monitor.env
StateDirectory=ai-tutor-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/ai-tutor-monitor/check_health.py
TimeoutStartSec=45
SuccessExitStatus=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LogNamespace=ai-tutor
